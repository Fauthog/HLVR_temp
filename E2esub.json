    },
    "21": {
      "content": "Experimental procedure",
      "end": 795480,
      "index": 21,
      "start": 793740
    },
    "22": {
      "content": "Tare a clean beaker to zero and set it to zero",
      "end": 798620,
      "index": 22,
      "start": 795480
    },
    "23": {
      "content": "Then pour honey into the beaker",
      "end": 803120,
      "index": 23,
      "start": 800980
    },
    "24": {
      "content": "until the mass reads 60g and record the weight",
      "end": 808680,
      "index": 24,
      "start": 803120
    },
    "25": {
      "content": "Tare a clean beaker to zero again",
      "end": 847240,
      "index": 25,
      "start": 842120
    },
    "26": {
      "content": "Add milk until the mass is 60g",
      "end": 852280,
      "index": 26,
      "start": 848240
    },
    "27": {
      "content": "Then pour samples of condensed milk, dish-washing liquid, water, vegetable oil, alcohol and motor oil into the beaker until each reaches 60g",
      "end": 862480,
      "index": 27,
      "start": 853280
    },
    "28": {
      "content": "Continue in sequence until all are measured",
      "end": 864160,
      "index": 28,
      "start": 861940
    },
    "29": {
      "content": "Next pour the remaining motor-oil sample into a measuring cylinder",
      "end": 908840,
      "index": 29,
      "start": 902240
    },
    "30": {
      "content": "to measure its volume",
      "end": 910940,
      "index": 30,
      "start": 908840
    },
    "31": {
      "content": "and record the value",
      "end": 913140,
      "index": 31,
      "start": 910940
    },
    "32": {
      "content": "Pour the remaining alcohol sample into a measuring cylinder",
      "end": 942160,
      "index": 32,
      "start": 937240
    },
    "33": {
      "content": "to measure its volume",
      "end": 944500,
      "index": 33,
      "start": 942160
    },
    "34": {
      "content": "and record the value",
      "end": 946540,
      "index": 34,
      "start": 944500
    },
    "35": {
      "content": "Then pour the remaining sample into a measuring cylinder",
      "end": 950200,
      "index": 35,
      "start": 946540
    },
    "36": {
      "content": "to measure its volume",
      "end": 951940,
      "index": 36,
      "start": 950200
    },
    "37": {
      "content": "and record all values",
      "end": 955440,
      "index": 37,
      "start": 951940
    },
    "38": {
      "content": "Use the recorded data to calculate the density of each liquid using the following formula",
      "end": 987880,
      "index": 38,
      "start": 981230
    },
    "39": {
      "content": "Density equals mass divided by volume",
      "end": 990880,
      "index": 39,
      "start": 987880
    }
